---
import '../styles/global.css';
import { site, TOOLS } from '../config';
interface Props { title: string; description: string; noindex?: boolean; jsonld?: object | object[] }
const { title, description, noindex = false, jsonld } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const fullTitle = title === site.name ? `${site.name} · Rice, pasta and meat calculators` : `${title} | ${site.name}`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#161210" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og-default.png', site.url).href} />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  {site.adsenseClient && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>}
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href="/" aria-label="ThaliMeter home">
        <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M5 19h30a15 15 0 0 1-30 0z" fill="#c2410c"/><path d="M8 19h24" stroke="#9a3412" stroke-width="2" stroke-linecap="round"/><path d="M15 14c-2-2.5 2-4.5 0-7M20 14c-2-2.5 2-4.5 0-7M25 14c-2-2.5 2-4.5 0-7" stroke="#15803d" stroke-width="2.2" fill="none" stroke-linecap="round"/><ellipse cx="20" cy="35.5" rx="7" ry="1.6" fill="#c2410c" opacity=".35"/></svg>
        <span>Thali<b>Meter</b></span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="/rice-calculator/" aria-current={path.startsWith('/rice-calculator') || path.startsWith('/rice/') ? 'page' : undefined}>Rice</a>
        <a href="/rice-to-water-ratio/" aria-current={path.startsWith('/rice-to-water') ? 'page' : undefined}>Water ratio</a>
        <a href="/pasta-calculator/" aria-current={path.startsWith('/pasta') ? 'page' : undefined}>Pasta</a>
        <a href="/meat-per-person-calculator/" aria-current={path.startsWith('/meat') ? 'page' : undefined}>Meat</a>
      </nav>
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div><h4>Calculators</h4><ul>{TOOLS.map((t) => <li><a href={t.href}>{t.name}</a></li>)}</ul></div>
        <div><h4>Rice for a crowd</h4><ul>{[10, 20, 50, 100].map((n) => <li><a href={`/rice/for-${n}-people/`}>Rice for {n} people</a></li>)}</ul></div>
        <div><h4>Pasta for a crowd</h4><ul>{[10, 20, 50, 100].map((n) => <li><a href={`/pasta/for-${n}-people/`}>Pasta for {n} people</a></li>)}</ul></div>
        <div><h4>ThaliMeter</h4><ul><li><a href="/about/">About</a></li><li><a href="/how-we-calculate/">How we calculate</a></li><li><a href="/privacy/">Privacy</a></li><li><a href="/contact/">Contact</a></li></ul></div>
      </div>
      <p class="fineprint">All amounts are planning estimates. Appetites, recipes and packaging vary. © {year} {site.operator}.</p>
    </div>
  </footer>
</body>
</html>
