---
import '../styles/global.css';
import { site, TOOLS, toolFor } from '../config';
import { RICE_COUNTS } from '../lib/presets';
import { i18n, LANGS, META, href, tpl } from '../i18n';
interface Props { title: string; description: string; noindex?: boolean; jsonld?: object | object[] }
const { title, description, noindex = false, jsonld } = Astro.props;
const path = Astro.url.pathname;
const { lang, base, d, m, h } = i18n(path);
const canonical = new URL(path, site.url).href;
// Long, answer-bearing titles drop the brand suffix so Google shows the answer, not the name.
const fullTitle = title.length > 44 ? title : `${title} | ${site.name}`;
const year = new Date().getFullYear();
const nav = [
  { href: '/rice-calculator/', label: d.site.nav.rice, cls: 'n-rice', on: base.startsWith('/rice-calculator') || base.startsWith('/rice/') || base.startsWith('/uncooked') },
  { href: '/rice-to-water-ratio/', label: d.site.nav.water, cls: 'n-water', on: base.startsWith('/rice-to-water') },
  { href: '/pasta-calculator/', label: d.site.nav.pasta, cls: 'n-pasta', on: base.startsWith('/pasta') },
  { href: '/meat-per-person-calculator/', label: d.site.nav.meat, cls: 'n-meat', on: base.startsWith('/meat') },
];
const footerRice = [4, 6, 8, 10, 12, 20, 50, 100].filter((n) => RICE_COUNTS.includes(n));
const people = (n: number) => tpl(d.site.footPeople, { n });
---
<!doctype html>
<html lang={m.code} dir={m.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  {!noindex && LANGS.map((l) => <link rel="alternate" hreflang={META[l].code} href={new URL(href(l, base), site.url).href} />)}
  {!noindex && <link rel="alternate" hreflang="x-default" href={new URL(base, site.url).href} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#16191b" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content={m.og} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og-default.png', site.url).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={d.site.ogAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
  {site.adsenseClient && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsenseClient}`} crossorigin="anonymous"></script>}
</head>
<body data-tool={toolFor(base)}>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href={h('/')} aria-label={d.site.homeAria}>
        <svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="29" fill="#dfe3e2" stroke="#16191b" stroke-width="5"/><circle cx="32" cy="32" r="20.5" fill="#fff"/><path d="M20.5 37A12.5 12.5 0 1 1 43.5 37" fill="none" stroke="#d7261e" stroke-width="6.5" stroke-linecap="round"/><path d="M32 33.5 39.5 24.5" stroke="#16191b" stroke-width="4" stroke-linecap="round"/><circle cx="32" cy="33.5" r="3.6" fill="#16191b"/><circle cx="25.5" cy="45" r="2.6" fill="#2443b8"/><circle cx="32" cy="46.5" r="2.6" fill="#f2b705"/><circle cx="38.5" cy="45" r="2.6" fill="#1f8a4c"/></svg>
        <span lang="en">ThaliMeter</span>
      </a>
      <div class="head-right">
        <nav class="nav" aria-label={d.site.navAria}>
          {nav.map((n) => <a class={n.cls} href={h(n.href)} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        {LANGS.length > 1 && (
          <details class="lang">
            <summary aria-label={d.site.language}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg>
              <span>{m.name}</span>
            </summary>
            <ul>{LANGS.map((l) => <li><a href={href(l, base)} hreflang={META[l].code} lang={META[l].code} aria-current={l === lang ? 'true' : undefined}>{META[l].name}</a></li>)}</ul>
          </details>
        )}
      </div>
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div><h4>{d.site.footCalcs}</h4><ul>{TOOLS.map((t) => <li><a href={h(t.href)}>{d.tools[t.key].name}</a></li>)}</ul></div>
        <div><h4>{d.site.footRice}</h4><ul>{footerRice.map((n) => <li><a href={h(`/rice/for-${n}-people/`)}>{people(n)}</a></li>)}</ul></div>
        <div><h4>{d.site.footPasta}</h4><ul>{[4, 10, 20, 50, 100].map((n) => <li><a href={h(`/pasta/for-${n}-people/`)}>{people(n)}</a></li>)}</ul></div>
        <div><h4>{d.site.footSite}</h4><ul><li><a href={h('/about/')}>{d.site.about}</a></li><li><a href={h('/questions/')}>{d.site.questions}</a></li><li><a href={h('/how-we-calculate/')}>{d.site.how}</a></li><li><a href={h('/privacy/')}>{d.site.privacy}</a></li><li><a href={h('/contact/')}>{d.site.contact}</a></li></ul></div>
      </div>
      <p class="fineprint">{tpl(d.site.fine, { year, operator: site.operator })}</p>
    </div>
  </footer>
</body>
</html>
