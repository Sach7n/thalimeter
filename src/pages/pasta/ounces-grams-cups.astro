---
import Guide from '../../components/Guide.astro';
import { PASTA, PASTA_MEAL, G_PER_OZ, round } from '../../lib/kitchen';
import { i18n } from '../../i18n';
const { d, f } = i18n(Astro.url.pathname);
const t = d.guide.oz;
const oz = [2, 3, 4, 6, 8, 12, 16, 24, 32];
const cup = PASTA.dryShort.gPerCup!;
---
<Guide slug="/pasta/ounces-grams-cups/">
  <div class="table-wrap"><table class="table">
    <thead><tr><th>{t.thDry}</th><th class="n">{t.thGrams}</th><th class="n">{t.thCups}</th><th class="n">{t.thMains}</th><th class="n">{t.thSides}</th><th class="n">{t.thCooked}</th></tr></thead>
    <tbody>{oz.map((o) => { const g = o * G_PER_OZ; return <tr><td>{o} oz{o % 16 === 0 ? ` (${o / 16} lb)` : ''}</td><td class="n">{round(g)} g</td><td class="n">{f.cups(g / cup)}</td><td class="n">{f.n(round(g / PASTA_MEAL.main.g, 0.5))}</td><td class="n">{Math.floor(g / PASTA_MEAL.side.g)}</td><td class="n">{round(g * PASTA.dryLong.yieldWt, 5)} g</td></tr>; })}</tbody>
  </table></div>
  <p class="table-note">{t.note}</p>
</Guide>
