---
import Base from '../../layouts/Base.astro';
import { GUIDES } from '../../lib/questions';
import { faqLd } from '../../lib/seo';
const groups = ['Rice', 'Pasta', 'Meat'] as const;
const all = GUIDES.flatMap((g) => g.faq);
---
<Base title="Cooking for a Crowd: Rice, Pasta and Meat Questions Answered" description="Straight answers to what people ask most: kg of rice for 50 people, how many people a cup of rice feeds, 100 g uncooked rice cooked, 2 oz of pasta, meat per person in kg." jsonld={faqLd(all)}>
  <section class="hero">
    <h1>Questions people ask</h1>
    <p>The questions people search most before they cook for a group, answered with the same numbers our calculators use.</p>
  </section>
  {groups.map((grp) => (
    <section class="qa qa-group">
      <h2>{grp}</h2>
      {GUIDES.filter((g) => g.group === grp).map((g) => (
        <Fragment>
          {g.faq.map((f) => <div class="qa-item"><h3>{f.q}</h3><p set:html={f.a} /></div>)}
          <p class="qa-more"><a href={g.slug}>{g.h1.replace(/\?$/, '')}: full chart</a></p>
        </Fragment>
      ))}
    </section>
  ))}
</Base>
