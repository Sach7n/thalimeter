---
import Base from '../layouts/Base.astro';
import RiceCalculator from '../components/RiceCalculator';
import Lid from '../components/Lid.astro';
import ToolRows from '../components/ToolRows.astro';
import AdSlot from '../components/AdSlot.astro';
import { site } from '../config';
import { RICE_COUNTS, PASTA_COUNTS } from '../lib/presets';
import { MEAT_PAGES } from '../lib/meat-pages';
const ld = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, description: 'Free calculators for how much rice, pasta and meat to cook per person.' };
---
<Base title="ThaliMeter: How Much Rice, Pasta and Meat to Cook for Any Crowd" description="How much rice per person? ¼ cup (50 g) uncooked as a side, ½ cup (85 g) as a main. Free calculators for rice, rice-to-water ratio, pasta and meat, in cups and grams." jsonld={ld}>
  <section class="hero">
    <h1>Cook the right amount.</h1>
    <div class="answer">
      <Lid n={1} size="lg" label="per person" />
      <div class="answer-figs">
        <div class="fig"><span class="fig-label">Rice per person, as a side</span><span class="fig-main">¼ cup</span><span class="fig-sub">50 g uncooked · makes ¾ cup cooked</span></div>
        <div class="fig"><span class="fig-label">Rice per person, as the main</span><span class="fig-main">½ cup</span><span class="fig-sub">85 g uncooked · makes 1½ cups cooked</span></div>
      </div>
    </div>
  </section>
  <section aria-labelledby="pick">
    <h2 id="pick" class="visually-hidden">Rice for a number of people</h2>
    <ul class="lids">{RICE_COUNTS.filter((n) => n <= 50).map((n) => <li><a href={`/rice/for-${n}-people/`}><Lid n={n} /><span>people</span></a></li>)}</ul>
  </section>
  <section class="section">
    <h2>Your exact crowd</h2>
    <p class="lede">Adults, children, how the rice is served and how you cook it. The answer updates as you go.</p>
    <RiceCalculator client:load />
  </section>
  <section class="section">
    <h2>All calculators</h2>
    <ToolRows />
  </section>
  <AdSlot />
  <section class="section">
    <h2>Pasta for a crowd</h2>
    <ul class="lids" data-tool="pasta">{PASTA_COUNTS.map((n) => <li><a href={`/pasta/for-${n}-people/`}><Lid n={n} /><span>people</span></a></li>)}</ul>
  </section>
  <section class="section">
    <h2>Meat for parties</h2>
    <ul class="links" data-tool="meat">{MEAT_PAGES.map((p) => <li><a href={`/meat/${p.slug}/`}>{p.h1}</a></li>)}</ul>
  </section>
  <section class="section prose">
    <h2>Why ThaliMeter</h2>
    <p>A <i>thali</i> is a plate with a little of everything, in the right amount. That is what we try to do for your kitchen. Our numbers come from cooks, food-service planning guides and package tests, and we show <a href="/how-we-calculate/">every assumption</a>.</p>
  </section>
</Base>
