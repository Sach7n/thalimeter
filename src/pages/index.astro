---
import Base from '../layouts/Base.astro';
import RiceCalculator from '../components/RiceCalculator';
import { site, TOOLS } from '../config';
import { RICE_COUNTS, PASTA_COUNTS } from '../lib/presets';
import { MEAT_PAGES } from '../lib/meat-pages';
const ld = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: site.url, description: 'Free kitchen calculators for rice, pasta and meat.' };
---
<Base title={site.name} description="Cook the right amount. Free calculators for how much rice, pasta and meat per person, rice to water ratios and uncooked to cooked rice." jsonld={ld}>
  <section class="hero">
    <h1>Cook the right amount.</h1>
    <p>No more half-empty pots or mountains of leftovers. Tell us who is coming, and get the exact amount of rice, pasta or meat to cook.</p>
  </section>
  <RiceCalculator client:load />
  <section class="section">
    <h2>All calculators</h2>
    <ul class="tools" style="margin-top:16px">
      {TOOLS.map((t) => <li><a class="tool-card" href={t.href}><span class="ic" aria-hidden="true">{t.icon}</span><h3>{t.name}</h3><p>{t.blurb}</p></a></li>)}
    </ul>
  </section>
  <section class="section">
    <h2>Rice for a crowd</h2>
    <ul class="links" style="margin-top:12px">{RICE_COUNTS.map((n) => <li><a href={`/rice/for-${n}-people/`}>Rice for {n}</a></li>)}</ul>
  </section>
  <section class="section">
    <h2>Pasta for a crowd</h2>
    <ul class="links" style="margin-top:12px">{PASTA_COUNTS.map((n) => <li><a href={`/pasta/for-${n}-people/`}>Pasta for {n}</a></li>)}</ul>
  </section>
  <section class="section">
    <h2>Meat for parties</h2>
    <ul class="links" style="margin-top:12px">{MEAT_PAGES.map((p) => <li><a href={`/meat/${p.slug}/`}>{p.h1}</a></li>)}</ul>
  </section>
  <section class="section prose">
    <h2>Why ThaliMeter</h2>
    <p>A <i>thali</i> is a plate with a little of everything, in the right amount. That is what we try to do for your kitchen. Our numbers come from cooks, food-service planning guides and package tests, and we show <a href="/how-we-calculate/">every assumption</a>.</p>
  </section>
</Base>
