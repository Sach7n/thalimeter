---
import Base from '../layouts/Base.astro';
import RiceCalculator from '../components/RiceCalculator';
import Lid from '../components/Lid.astro';
import ToolRows from '../components/ToolRows.astro';
import AdSlot from '../components/AdSlot.astro';
import { site } from '../config';
import { RICE_COUNTS, PASTA_COUNTS } from '../lib/presets';
import { MEAT_PAGES } from '../lib/meat-pages';
import { GUIDES } from '../lib/questions';
import { i18n, islandT, tpl } from '../i18n';
const { lang, d, h } = i18n(Astro.url.pathname);
const p = d.home;
const ld = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: new URL(h('/'), site.url).href, description: p.ldDescription, inLanguage: lang };
---
<Base title={p.title} description={p.description} jsonld={ld}>
  <section class="hero">
    <h1>{p.h1}</h1>
    <div class="answer">
      <Lid n={1} size="lg" label={p.perPerson} />
      <div class="answer-figs">
        <div class="fig"><span class="fig-label">{p.sideLabel}</span><span class="fig-main">{p.sideMain}</span><span class="fig-sub">{p.sideSub}</span></div>
        <div class="fig"><span class="fig-label">{p.mainLabel}</span><span class="fig-main">{p.mainMain}</span><span class="fig-sub">{p.mainSub}</span></div>
      </div>
    </div>
  </section>
  <section aria-labelledby="pick">
    <h2 id="pick" class="visually-hidden">{p.pick}</h2>
    <ul class="lids">{RICE_COUNTS.filter((n) => n <= 50).map((n) => <li><a href={h(`/rice/for-${n}-people/`)}><Lid n={n} /><span>{d.site.people}</span></a></li>)}</ul>
  </section>
  <section class="section">
    <h2>{p.crowd}</h2>
    <p class="lede">{p.crowdLede}</p>
    <RiceCalculator client:load t={islandT(lang)} />
  </section>
  <section class="section">
    <h2>{p.all}</h2>
    <ToolRows />
  </section>
  <AdSlot />
  <section class="section">
    <h2>{p.pasta}</h2>
    <ul class="lids" data-tool="pasta">{PASTA_COUNTS.map((n) => <li><a href={h(`/pasta/for-${n}-people/`)}><Lid n={n} /><span>{d.site.people}</span></a></li>)}</ul>
  </section>
  <section class="section">
    <h2>{p.meat}</h2>
    <ul class="links" data-tool="meat">{MEAT_PAGES.map((m) => <li><a href={h(`/meat/${m.slug}/`)}>{d.meatOcc.pages[m.slug].h1}</a></li>)}</ul>
  </section>
  <section class="section prose">
    <h2>{p.questions}</h2>
    <ul class="links">{GUIDES.map((g) => <li><a href={h(g.slug)}>{d.guide[g.key].h1.replace(/[?？؟;]$/, '')}</a></li>)}<li><a href={h('/questions/')}>{p.allQuestions}</a></li></ul>
  </section>
  <section class="section prose">
    <h2>{p.why}</h2>
    <p set:html={tpl(p.whyText, { how: h('/how-we-calculate/') })} />
  </section>
</Base>
