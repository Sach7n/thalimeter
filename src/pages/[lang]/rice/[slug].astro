---
// The same page in another language: the page reads its language from the URL.
import Page from '../../rice/[slug].astro';
import { otherLangs } from '../../../i18n';
import { riceSlugPaths } from '../../../lib/presets';
export const getStaticPaths = () => otherLangs().flatMap((l) => riceSlugPaths().map((p) => ({ params: { ...l.params, ...p.params }, props: { ...l.props, ...p.props } })));
---
<Page {...Astro.props} />
