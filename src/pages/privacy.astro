---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { i18n, tpl } from '../i18n';
const { d } = i18n(Astro.url.pathname);
const p = d.privacy;
const email = site.contactEmail;
---
<Base title={p.title} description={p.description}>
  <section class="hero"><h1>{p.h1}</h1><p class="muted">{tpl(p.updated, { date: p.date })}</p></section>
  <div class="prose">
    {p.englishPrevails && <p class="muted"><i>{p.englishPrevails}</i></p>}
    <p>{tpl(p.intro, { name: site.name, url: site.url, operator: site.operator })}</p>
    <h2>{p.typeH}</h2>
    <p>{p.type}</p>
    <h2>{p.logsH}</h2>
    <p>{p.logs}</p>
    <h2>{p.adsH}</h2>
    <p>{p.ads1}</p>
    <p set:html={p.ads2} />
    <p>{p.ads3}</p>
    <h2>{p.kidsH}</h2>
    <p>{p.kids}</p>
    <h2>{p.contactH}</h2>
    <p set:html={tpl(p.contact, { email })} />
  </div>
</Base>
