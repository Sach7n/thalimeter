---
import Base from '../layouts/Base.astro';
import RiceWaterCalculator from '../components/RiceWaterCalculator';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { faqLd, appLd } from '../lib/seo';
import { i18n, islandT } from '../i18n';
const { lang, d, h } = i18n(Astro.url.pathname);
const p = d.water;
---
<Base title={p.title} description={p.description} jsonld={[appLd(p.appName, h('/rice-to-water-ratio/'), p.appDesc), faqLd(p.faq)]}>
  <section class="hero">
    <h1>{p.h1}</h1>
    <p>{p.lede}</p>
    <p class="answer" set:html={p.answer} />
  </section>
  <RiceWaterCalculator client:load t={islandT(lang)} />
  <AdSlot />
  <section class="section prose">
    <h2>{p.whyH}</h2>
    <p>{p.why1}</p>
    <p>{p.why2}</p>
    <h2>{p.rulesH}</h2>
    <ol>{p.rules.map((r) => <li set:html={r} />)}</ol>
  </section>
  <Faq items={p.faq} />
</Base>
