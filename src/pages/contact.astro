---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { i18n } from '../i18n';
const { d } = i18n(Astro.url.pathname);
const p = d.contact;
---
<Base title={p.title} description={p.description}>
  <section class="hero"><h1>{p.h1}</h1></section>
  <div class="prose">
    <p>{p.lede}</p>
    <p><a class="btn" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>
    <p class="muted">{p.reply}</p>
  </div>
</Base>
