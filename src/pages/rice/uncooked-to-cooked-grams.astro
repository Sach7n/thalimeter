---
import Guide from '../../components/Guide.astro';
import { RICE, convertRice, cupsText, round, type RiceType } from '../../lib/kitchen';
const types: RiceType[] = ['white', 'basmati', 'jasmine', 'brown'];
const grams = [25, 40, 50, 60, 70, 75, 80, 90, 100, 125, 150, 200, 250];
const cups: [number, string][] = [[0.25, '¼ cup'], [1 / 3, '⅓ cup'], [0.5, '½ cup'], [0.75, '¾ cup'], [1, '1 cup'], [1.5, '1½ cups'], [2, '2 cups'], [3, '3 cups']];
---
<Guide slug="/rice/uncooked-to-cooked-grams/" tool={{ href: '/uncooked-to-cooked-rice/', name: 'uncooked to cooked rice converter' }}>
  <div class="table-wrap"><table class="table">
    <thead><tr><th>Uncooked</th>{types.map((t) => <th class="n">{RICE[t].label}, cooked</th>)}</tr></thead>
    <tbody>{grams.map((g) => <tr><td>{g} g</td>{types.map((t) => <td class="n">{round(g * RICE[t].yieldWt, 5)} g</td>)}</tr>)}</tbody>
  </table></div>
  <h2 class="section">In cups</h2>
  <div class="table-wrap" style="margin-top:18px"><table class="table">
    <thead><tr><th>Uncooked white rice</th><th class="n">Makes cooked</th><th class="n">Cooked weight</th></tr></thead>
    <tbody>{cups.map(([c, label]) => { const r = convertRice(c, 'cups', 'toCooked', 'white'); return <tr><td>{label}</td><td class="n">{cupsText(r.cookedCups)}</td><td class="n">{round(r.cookedG, 5)} g</td></tr>; })}</tbody>
  </table></div>
  <p class="table-note">Rice cooked by absorption (lid on, water fully absorbed). Boiled and drained rice holds a little more water.</p>
</Guide>
