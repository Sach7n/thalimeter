---
import Guide from '../../components/Guide.astro';
import { RICE, convertRice, round, type RiceType } from '../../lib/kitchen';
import { i18n, tpl } from '../../i18n';
const { d, f } = i18n(Astro.url.pathname);
const t = d.guide.grams;
const types: RiceType[] = ['white', 'basmati', 'jasmine', 'brown'];
const grams = [25, 40, 50, 60, 70, 75, 80, 90, 100, 125, 150, 200, 250];
const cups: [number, string][] = [[0.25, '¼'], [1 / 3, '⅓'], [0.5, '½'], [0.75, '¾'], [1, '1'], [1.5, '1½'], [2, '2'], [3, '3']];
---
<Guide slug="/rice/uncooked-to-cooked-grams/">
  <div class="table-wrap"><table class="table">
    <thead><tr><th>{t.thUncooked}</th>{types.map((x) => <th class="n">{tpl(t.thCooked, { label: d.k.rice[x].label })}</th>)}</tr></thead>
    <tbody>{grams.map((g) => <tr><td>{g} g</td>{types.map((x) => <td class="n">{round(g * RICE[x].yieldWt, 5)} g</td>)}</tr>)}</tbody>
  </table></div>
  <h2 class="section">{t.cupsH}</h2>
  <div class="table-wrap" style="margin-top:18px"><table class="table">
    <thead><tr><th>{t.thWhite}</th><th class="n">{t.thMakes}</th><th class="n">{t.thWeight}</th></tr></thead>
    <tbody>{cups.map(([c, label]) => { const r = convertRice(c, 'cups', 'toCooked', 'white'); return <tr><td>{label} {c > 1 ? d.units.cups : d.units.cup}</td><td class="n">{f.cups(r.cookedCups)}</td><td class="n">{round(r.cookedG, 5)} g</td></tr>; })}</tbody>
  </table></div>
  <p class="table-note">{t.note}</p>
</Guide>
