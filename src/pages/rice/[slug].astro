---
import Base from '../../layouts/Base.astro';
import RiceCalculator from '../../components/RiceCalculator';
import Faq from '../../components/Faq.astro';
import AdSlot from '../../components/AdSlot.astro';
import Lid from '../../components/Lid.astro';
import { rice, RICE, RICE_DEFAULT, RICE_MEAL, round, type RiceType, type RiceMeal } from '../../lib/kitchen';
import { RICE_COUNTS, RICE_TYPE_PAGES, riceSlugPaths } from '../../lib/presets';
import { faqLd, appLd, crumbLd } from '../../lib/seo';
import { i18n, islandT, tpl } from '../../i18n';

export function getStaticPaths() { return riceSlugPaths(); }
const p = Astro.props as { kind: 'count'; n: number } | { kind: 'type'; type: RiceType };
const { lang, d, f, h } = i18n(Astro.url.pathname);
const path = Astro.url.pathname;
const meals = Object.keys(RICE_MEAL) as RiceMeal[];
const type: RiceType = p.kind === 'type' ? p.type : 'white';
const n = p.kind === 'count' ? p.n : 1;
const s = rice({ ...RICE_DEFAULT, type, adults: n, meal: 'side' }), m = rice({ ...RICE_DEFAULT, type, adults: n, meal: 'main' });
const t = RICE[type];
const cap = (x: string) => x[0].toUpperCase() + x.slice(1);
let title: string, h1: string, description: string, crumb: string, note: string, preset: object, faq: { q: string; a: string }[], table: { label: string; cups: string; weight: string; water: string; cooked: string }[];

if (p.kind === 'count') {
  const c = d.riceN;
  const v = {
    n, range: `${f.dec(f.cupsNum(s.dryCups))}–${f.dec(f.cupsNum(m.dryCups))}`,
    sCups: f.cups(s.dryCups), mCups: f.cups(m.dryCups), dCups: f.cups(rice({ ...RICE_DEFAULT, adults: n, meal: 'ricedish' }).dryCups),
    sG: f.g(s.dryG), mG: f.g(m.dryG), sLb: f.lb(s.dryG), mLb: f.lb(m.dryG),
    sCooked: f.cups(s.cookedCups), mCooked: f.cups(m.cookedCups), sWater: f.cups(s.waterCups), mWater: f.cups(m.waterCups),
    sWaterL: f.l(s.waterMl), mWaterL: f.l(m.waterMl), sCooker: f.n(round(s.cookerCups, 0.5)), mCooker: f.n(round(m.cookerCups, 0.5)),
    pot: m.potL > 12 ? tpl(c.potBig, { pot: f.n(m.potL), batches: m.cookerBatches.large }) : tpl(c.potOk, { pot: f.n(m.potL), qt: f.qt(m.potL * 1000) }),
  };
  title = tpl(c.title, v); h1 = tpl(c.h1, v); crumb = tpl(c.crumb, v); description = tpl(c.description, v); note = tpl(c.note, v);
  preset = { adults: n, meal: 'side' };
  table = meals.map((k) => { const r = rice({ ...RICE_DEFAULT, adults: n, meal: k }); return { label: d.k.riceMeal[k].label, cups: f.cups(r.dryCups), weight: `${f.g(r.dryG)} · ${f.lb(r.dryG)}`, water: `${f.cups(r.waterCups)} · ${f.l(r.waterMl)}`, cooked: `${f.cups(r.cookedCups)} · ${f.g(r.cookedG)}` }; });
  faq = c.faq.map((x) => ({ q: tpl(x.q, v), a: tpl(x.a, v) }));
} else {
  const c = d.riceType, name = c.names[type];
  const v = {
    name, Name: cap(name), Title: name.replace(/(^|\s)\S/g, (x) => x.toUpperCase()),
    sG: f.g(s.dryG), sCups: f.cups(s.dryCups), mG: f.g(m.dryG), mCups: f.cups(m.dryCups),
    water: f.n(t.water.stovetop), stove: f.n(t.water.stovetop), cooker: f.n(t.water.cooker), ip: f.n(t.water.instantpot), yield: f.cups(t.yieldVol), tip: d.k.rice[type].tip,
  };
  title = tpl(c.title, v); h1 = tpl(c.h1, v); crumb = tpl(c.crumb, v); description = tpl(c.description, v); note = tpl(c.note, v);
  preset = { type };
  table = [2, 4, 6, 10, 20, 50].map((k) => { const r = rice({ ...RICE_DEFAULT, type, adults: k, meal: 'main' }); return { label: tpl(c.rowPeople, { n: k }), cups: f.cups(r.dryCups), weight: `${f.g(r.dryG)} · ${f.lb(r.dryG)}`, water: `${f.cups(r.waterCups)} · ${f.l(r.waterMl)}`, cooked: f.cups(r.cookedCups) }; });
  faq = c.faq.map((x) => ({ q: tpl(x.q, v), a: tpl(x.a, v) }));
}
const c = d.riceN;
const uncooked = (g: number) => tpl(c.uncooked, { g: f.g(g), lb: f.lb(g) });
---
<Base title={title} description={description} jsonld={[appLd(d.rice.appName, path, description), faqLd(faq), crumbLd([[d.site.home, h('/')], [d.rice.appName, h('/rice-calculator/')], [crumb, path]])]}>
  <nav class="crumbs" aria-label={d.site.crumbAria}><a href={h('/')}>{d.site.home}</a> › <a href={h('/rice-calculator/')}>{d.rice.appName}</a> › {crumb}</nav>
  <section class="hero">
    <h1>{h1}</h1>
    <div class="answer">
      <Lid n={n} size="lg" label={p.kind === 'count' ? tpl(d.site.footPeople, { n }) : d.riceType.perPerson} />
      <div class="answer-figs">
        <div class="fig"><span class="fig-label">{c.side}</span><span class="fig-main">{f.cups(s.dryCups)}</span><span class="fig-sub">{uncooked(s.dryG)}</span></div>
        <div class="fig"><span class="fig-label">{c.main}</span><span class="fig-main">{f.cups(m.dryCups)}</span><span class="fig-sub">{uncooked(m.dryG)}</span></div>
      </div>
    </div>
    <p class="answer-note">{note}</p>
  </section>
  <section>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>{p.kind === 'count' ? c.thServed : d.riceType.thFor}</th><th class="n">{c.thCups}</th><th class="n">{c.thWeight}</th><th class="n hide-sm">{c.thWater}</th><th class="n hide-sm">{c.thCooked}</th></tr></thead>
      <tbody>{table.map((r) => <tr><td>{r.label}</td><td class="n">{r.cups}</td><td class="n">{r.weight}</td><td class="n hide-sm">{r.water}</td><td class="n hide-sm">{r.cooked}</td></tr>)}</tbody>
    </table></div>
    <p class="table-note">{p.kind === 'count' ? c.tableNote : d.riceType.tableNote} {c.usCup} <a href={h('/how-we-calculate/')}>{d.site.how}</a></p>
  </section>
  <section class="section">
    <h2>{d.site.changeNumbers}</h2>
    <p class="lede">{c.changeLede}</p>
    <RiceCalculator client:visible preset={preset} t={islandT(lang)} />
  </section>
  <AdSlot />
  <Faq items={faq} />
  <section class="section">
    <h2>{c.more}</h2>
    <ul class="lids">{RICE_COUNTS.map((k) => <li><a href={h(`/rice/for-${k}-people/`)} aria-current={p.kind === 'count' && k === n ? 'page' : undefined}><Lid n={k} /><span>{d.site.people}</span></a></li>)}</ul>
  </section>
  <section class="section">
    <h2>{c.byType}</h2>
    <ul class="links">{RICE_TYPE_PAGES.map((r) => <li><a href={h(`/rice/${r.slug}/`)}>{cap(d.riceType.names[r.type])}</a></li>)}<li><a href={h('/rice-to-water-ratio/')}>{d.rice.linkWater}</a></li><li><a href={h('/rice/kg-of-rice-for-people/')}>{d.rice.linkKg}</a></li><li><a href={h('/rice/how-many-people-does-rice-feed/')}>{d.rice.linkFeeds}</a></li></ul>
  </section>
</Base>
