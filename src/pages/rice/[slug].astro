---
import Base from '../../layouts/Base.astro';
import RiceCalculator from '../../components/RiceCalculator';
import Faq from '../../components/Faq.astro';
import AdSlot from '../../components/AdSlot.astro';
import Lid from '../../components/Lid.astro';
import { rice, RICE, RICE_DEFAULT, RICE_MEAL, cupsText, cupsNum, gramsText, lbText, litresText, quartsText, round, type RiceType, type RiceMeal } from '../../lib/kitchen';
import { RICE_COUNTS, RICE_TYPE_PAGES } from '../../lib/presets';
import { faqLd, appLd, crumbLd } from '../../lib/seo';

export function getStaticPaths() {
  return [
    ...RICE_COUNTS.map((n) => ({ params: { slug: `for-${n}-people` }, props: { kind: 'count' as const, n } })),
    ...RICE_TYPE_PAGES.map((p) => ({ params: { slug: p.slug }, props: { kind: 'type' as const, type: p.type, name: p.name } })),
  ];
}
const p = Astro.props as { kind: 'count'; n: number } | { kind: 'type'; type: RiceType; name: string };
const meals = Object.keys(RICE_MEAL) as RiceMeal[];
const path = Astro.url.pathname;
const type: RiceType = p.kind === 'type' ? p.type : 'white';
const n = p.kind === 'count' ? p.n : 1;
const s = rice({ ...RICE_DEFAULT, type, adults: n, meal: 'side' }), m = rice({ ...RICE_DEFAULT, type, adults: n, meal: 'main' });
const t = RICE[type];
let title: string, h1: string, description: string, crumb: string, note: string, preset: object, faq: { q: string; a: string }[], table: { label: string; cups: string; weight: string; water: string; cooked: string }[];

if (p.kind === 'count') {
  title = `How Many Cups of Rice for ${n} People? ${cupsNum(s.dryCups)}–${cupsNum(m.dryCups)} Cups`;
  h1 = `How many cups of rice for ${n} people?`;
  crumb = `Rice for ${n} people`;
  description = `For ${n} people, cook ${cupsText(s.dryCups)} (${gramsText(s.dryG)}) of uncooked rice as a side, or ${cupsText(m.dryCups)} (${gramsText(m.dryG)}) when rice is the main part of the meal. Water, rice-cooker cups and pot size included.`;
  note = `That makes about ${cupsText(s.cookedCups)} or ${cupsText(m.cookedCups)} of cooked rice. On the stove, use ${cupsText(s.waterCups)} or ${cupsText(m.waterCups)} of water (${litresText(s.waterMl)} or ${litresText(m.waterMl)}). In rice-cooker cups (180 ml): ${round(s.cookerCups, 0.5)} or ${round(m.cookerCups, 0.5)}.`;
  preset = { adults: n, meal: 'side' };
  table = meals.map((k) => { const r = rice({ ...RICE_DEFAULT, adults: n, meal: k }); return { label: RICE_MEAL[k].label, cups: cupsText(r.dryCups), weight: `${gramsText(r.dryG)} · ${lbText(r.dryG)}`, water: `${cupsText(r.waterCups)} · ${litresText(r.waterMl)}`, cooked: `${cupsText(r.cookedCups)} · ${gramsText(r.cookedG)}` }; });
  faq = [
    { q: `How many cups of rice for ${n} people?`, a: `${cupsText(s.dryCups)} of uncooked rice as a side dish, ${cupsText(m.dryCups)} when rice is the main part of the meal, and ${cupsText(rice({ ...RICE_DEFAULT, adults: n, meal: 'ricedish' }).dryCups)} for a rice dish such as biryani or fried rice.` },
    { q: `How many grams or pounds of rice for ${n} people?`, a: `${gramsText(s.dryG)} (${lbText(s.dryG)}) of uncooked rice as a side and ${gramsText(m.dryG)} (${lbText(m.dryG)}) as a main.` },
    { q: `How much water for rice for ${n} people?`, a: `For long-grain white rice on the stove, ${cupsText(s.waterCups)} (${litresText(s.waterMl)}) for the side-dish amount and ${cupsText(m.waterCups)} (${litresText(m.waterMl)}) for the main amount. A rice cooker needs less: fill to the line for ${round(m.cookerCups, 0.5)} rice-cooker cups.` },
    { q: `Can I cook rice for ${n} people in one pot?`, a: m.potL > 12 ? `This is a lot of rice. Use a ${m.potL} L stock pot, or cook it in ${m.cookerBatches.large} batches in a large (10-cup) rice cooker. Large batches cook more evenly in the oven: bake covered at 180 °C (350 °F) for about 35 minutes.` : `Yes. Use a pot of at least ${m.potL} L (${quartsText(m.potL * 1000)}) so the rice has space to grow.` },
  ];
} else {
  const nm = p.name; const Nm = nm[0].toUpperCase() + nm.slice(1);
  title = `How Much ${Nm.replace(/\b\w/g, (c) => c.toUpperCase())} Per Person? Cups, Grams and Water`;
  h1 = `How much ${nm} per person?`;
  crumb = `${Nm} per person`;
  description = `${Nm} per person: ${gramsText(s.dryG)} (${cupsText(s.dryCups)}) uncooked as a side, ${gramsText(m.dryG)} (${cupsText(m.dryCups)}) as a main. Water ratio, cooked yield and a calculator for any number of guests.`;
  note = `On the stove, use ${t.water.stovetop} cups of water for each cup of ${nm}. 1 cup uncooked makes about ${cupsText(t.yieldVol)} cooked. ${t.tip}`;
  preset = { type };
  table = [2, 4, 6, 10, 20, 50].map((k) => { const r = rice({ ...RICE_DEFAULT, type, adults: k, meal: 'main' }); return { label: `${k} people`, cups: cupsText(r.dryCups), weight: `${gramsText(r.dryG)} · ${lbText(r.dryG)}`, water: `${cupsText(r.waterCups)} · ${litresText(r.waterMl)}`, cooked: cupsText(r.cookedCups) }; });
  faq = [
    { q: `How much water for 1 cup of ${nm}?`, a: `${t.water.stovetop} cups on the stove, ${t.water.cooker} cups in a rice cooker and ${t.water.instantpot} cup in an Instant Pot.` },
    { q: `How much cooked ${nm} does 1 cup make?`, a: `About ${cupsText(t.yieldVol)} of cooked rice.` },
    { q: `Any tips for ${nm}?`, a: t.tip },
  ];
}
const tableHead = p.kind === 'count' ? 'How rice is served' : 'Main dish for';
---
<Base title={title} description={description} jsonld={[appLd('Rice calculator', path, description), faqLd(faq), crumbLd([['Home', '/'], ['Rice calculator', '/rice-calculator/'], [crumb, path]])]}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/rice-calculator/">Rice calculator</a> › {crumb}</nav>
  <section class="hero">
    <h1>{h1}</h1>
    <div class="answer">
      <Lid n={n} size="lg" label={p.kind === 'count' ? `${n} people` : 'per person'} />
      <div class="answer-figs">
        <div class="fig"><span class="fig-label">As a side dish</span><span class="fig-main">{cupsText(s.dryCups)}</span><span class="fig-sub">{gramsText(s.dryG)} · {lbText(s.dryG)} uncooked</span></div>
        <div class="fig"><span class="fig-label">As the main part of the meal</span><span class="fig-main">{cupsText(m.dryCups)}</span><span class="fig-sub">{gramsText(m.dryG)} · {lbText(m.dryG)} uncooked</span></div>
      </div>
    </div>
    <p class="answer-note">{note}</p>
  </section>
  <section>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>{tableHead}</th><th class="n">Uncooked (cups)</th><th class="n">Uncooked (weight)</th><th class="n hide-sm">Water (stove)</th><th class="n hide-sm">Cooked</th></tr></thead>
      <tbody>{table.map((r) => <tr><td>{r.label}</td><td class="n">{r.cups}</td><td class="n">{r.weight}</td><td class="n hide-sm">{r.water}</td><td class="n hide-sm">{r.cooked}</td></tr>)}</tbody>
    </table></div>
    <p class="table-note">{p.kind === 'count' ? 'Long-grain white rice, adults, normal appetite.' : 'Adults, normal appetite.'} US cups (237 ml). <a href="/how-we-calculate/">How we calculate</a></p>
  </section>
  <section class="section">
    <h2>Change the numbers</h2>
    <p class="lede">Add children, change the rice or the pot, or plan for a buffet.</p>
    <RiceCalculator client:visible preset={preset} />
  </section>
  <AdSlot />
  <Faq items={faq} />
  <section class="section">
    <h2>Rice for more people</h2>
    <ul class="lids">{RICE_COUNTS.map((c) => <li><a href={`/rice/for-${c}-people/`} aria-current={p.kind === 'count' && c === n ? 'page' : undefined}><Lid n={c} /><span>people</span></a></li>)}</ul>
  </section>
  <section class="section">
    <h2>By type of rice</h2>
    <ul class="links">{RICE_TYPE_PAGES.map((r) => <li><a href={`/rice/${r.slug}/`}>{r.name[0].toUpperCase() + r.name.slice(1)}</a></li>)}<li><a href="/rice-to-water-ratio/">Rice to water ratio</a></li><li><a href="/rice/kg-of-rice-for-people/">Kg of rice for a crowd</a></li><li><a href="/rice/how-many-people-does-rice-feed/">How many people a cup feeds</a></li></ul>
  </section>
</Base>
