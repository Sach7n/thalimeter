---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { i18n, tpl } from '../i18n';
const { d, h } = i18n(Astro.url.pathname);
const p = d.about;
---
<Base title={p.title} description={p.description}>
  <section class="hero"><h1>{p.h1}</h1></section>
  <div class="prose">
    {p.paras.map((x) => <p set:html={tpl(x, { how: h('/how-we-calculate/'), operator: site.operator, email: site.contactEmail })} />)}
  </div>
</Base>
