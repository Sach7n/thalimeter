---
import Base from '../layouts/Base.astro';
import CookedConverter from '../components/CookedConverter';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { RICE, convertRice, type RiceType } from '../lib/kitchen';
import { faqLd, appLd } from '../lib/seo';
import { i18n, islandT } from '../i18n';
const { lang, d, f, h } = i18n(Astro.url.pathname);
const p = d.convert;
const types = Object.keys(RICE) as RiceType[];
---
<Base title={p.title} description={p.description} jsonld={[appLd(p.appName, h('/uncooked-to-cooked-rice/'), p.appDesc), faqLd(p.faq)]}>
  <section class="hero">
    <h1>{p.h1}</h1>
    <p>{p.lede}</p>
  </section>
  <CookedConverter client:load t={islandT(lang)} />
  <AdSlot />
  <p class="qa-more section"><a href={h('/rice/uncooked-to-cooked-grams/')}>{p.more}</a> · <a href={h('/questions/')}>{p.moreQuestions}</a></p>
  <section class="section">
    <h2>{p.chartH}</h2>
    <div class="table-wrap" style="margin-top:12px"><table class="table">
      <thead><tr><th>{p.thRice}</th><th class="n">{p.thCup}</th><th class="n">{p.th100}</th><th class="n">{p.thFor}</th></tr></thead>
      <tbody>{types.map((t) => { const a = convertRice(1, 'cups', 'toCooked', t); const b = convertRice(100, 'grams', 'toCooked', t); const c = convertRice(1, 'cups', 'toDry', t); return (
        <tr><td>{d.k.rice[t].label}</td><td class="n">{f.cups(a.cookedCups)}</td><td class="n">{f.g(b.cookedG)}</td><td class="n">{f.cups(c.dryCups)} · {f.g(c.dryG)}</td></tr>); })}</tbody>
    </table></div>
  </section>
  <Faq items={p.faq} />
</Base>
