---
import Base from '../layouts/Base.astro';
import PastaCalculator from '../components/PastaCalculator';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { pasta, PASTA_DEFAULT, round } from '../lib/kitchen';
import { PASTA_COUNTS } from '../lib/presets';
import { faqLd, appLd } from '../lib/seo';
import { i18n, islandT, tpl } from '../i18n';
const { lang, d, f, h } = i18n(Astro.url.pathname);
const p = d.pasta;
const rows = PASTA_COUNTS.map((n) => ({ n, side: pasta({ ...PASTA_DEFAULT, adults: n, meal: 'side' }), main: pasta({ ...PASTA_DEFAULT, adults: n, meal: 'main' }) }));
---
<Base title={p.title} description={p.description} jsonld={[appLd(p.appName, h('/pasta-calculator/'), p.appDesc), faqLd(p.faq)]}>
  <section class="hero">
    <h1>{p.h1}</h1>
    <p>{p.lede}</p>
    <p class="answer" set:html={p.answer} />
  </section>
  <PastaCalculator client:load t={islandT(lang)} />
  <AdSlot />
  <p class="qa-more section"><a href={h('/pasta/ounces-grams-cups/')}>{p.more}</a> · <a href={h('/questions/')}>{p.moreQuestions}</a></p>
  <section class="section prose">
    <h2>{p.whyH}</h2>
    <p>{p.why}</p>
  </section>
  <section class="section">
    <h2>{p.chartH}</h2>
    <p class="lede">{p.chartLede}</p>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>{p.thPeople}</th><th class="n">{p.thSide}</th><th class="n">{p.thMain}</th><th class="n">{p.thBoxes}</th><th class="n">{p.thPacks}</th></tr></thead>
      <tbody>{rows.map(({ n, side, main }) => (
        <tr><td><a href={h(`/pasta/for-${n}-people/`)}>{tpl(d.site.footPeople, { n })}</a></td><td class="n">{f.g(side.g)} · {f.lb(side.g)}</td><td class="n">{f.g(main.g)} · {f.lb(main.g)}</td><td class="n">{f.n(round(main.boxes16oz, 0.25))}</td><td class="n">{f.n(round(main.packs500g, 0.25))}</td></tr>
      ))}</tbody>
    </table></div>
  </section>
  <Faq items={p.faq} />
</Base>
