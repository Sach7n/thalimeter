---
import Base from '../../layouts/Base.astro';
import MeatCalculator from '../../components/MeatCalculator';
import AdSlot from '../../components/AdSlot.astro';
import Lid from '../../components/Lid.astro';
import { meat, MEAT, MEAT_DEFAULT, gramsText, lbText } from '../../lib/kitchen';
import { MEAT_PAGES } from '../../lib/meat-pages';
import { appLd, crumbLd } from '../../lib/seo';
export function getStaticPaths() { return MEAT_PAGES.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props as { p: (typeof MEAT_PAGES)[number] };
const rows = [4, 6, 8, 10, 15, 20, 30, 50, 100].map((n) => ({ n, r: meat({ ...MEAT_DEFAULT, type: p.type, adults: n }) }));
const path = Astro.url.pathname;
const ten = meat({ ...MEAT_DEFAULT, type: p.type, adults: 10 });
---
<Base title={p.title} description={`${p.intro} Chart for 4 to 100 guests and a calculator.`} jsonld={[appLd('Meat per person calculator', path, p.intro), crumbLd([['Home', '/'], ['Meat per person', '/meat-per-person-calculator/'], [p.h1, path]])]}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> › <a href="/meat-per-person-calculator/">Meat per person</a> › {p.h1}</nav>
  <section class="hero">
    <h1>{p.h1}?</h1>
    <div class="answer">
      <Lid n={1} size="lg" label="per adult" />
      <div class="answer-figs">
        <div class="fig"><span class="fig-label">Raw weight per adult</span><span class="fig-main">{lbText(MEAT[p.type].rawG)}</span><span class="fig-sub">{MEAT[p.type].rawG} g · the only main</span></div>
        <div class="fig"><span class="fig-label">For 10 adults</span><span class="fig-main">{lbText(ten.rawG)}</span><span class="fig-sub">{gramsText(ten.rawG)} raw</span></div>
      </div>
    </div>
    <p class="answer-note">{p.intro}</p>
  </section>
  <section>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>Guests (adults)</th><th class="n">Raw weight to buy</th>{p.type === 'burgers' && <th class="n">Patties</th>}</tr></thead>
      <tbody>{rows.map(({ n, r }) => <tr><td>{n}</td><td class="n">{lbText(r.rawG)} · {gramsText(r.rawG)}</td>{p.type === 'burgers' && <td class="n">{r.patties}</td>}</tr>)}</tbody>
    </table></div>
    <p class="table-note">{MEAT[p.type].label}, the only main, normal appetite.</p>
  </section>
  <section class="section">
    <h2>Change the numbers</h2>
    <p class="lede">Add children, add other mains, or plan for leftovers.</p>
    <MeatCalculator client:visible preset={{ type: p.type }} />
  </section>
  <AdSlot />
  <section class="section prose"><h2>Tips</h2><ul>{p.tips.map((t) => <li>{t}</li>)}</ul></section>
  <section class="section">
    <h2>Other occasions</h2>
    <ul class="links">{MEAT_PAGES.filter((x) => x.slug !== p.slug).map((x) => <li><a href={`/meat/${x.slug}/`}>{x.h1}</a></li>)}</ul>
  </section>
</Base>
