---
import Guide from '../../components/Guide.astro';
import { MEAT } from '../../lib/kitchen';
import { MEAT_ROWS } from '../../lib/questions';
import { i18n, tpl } from '../../i18n';
const { d, f } = i18n(Astro.url.pathname);
const t = d.guide.meatKg;
---
<Guide slug="/meat/per-person-in-kg/">
  <div class="table-wrap"><table class="table">
    <thead><tr><th>{t.thMeat}</th><th class="n">{t.thPer}</th>{[10, 25, 50].map((n) => <th class="n">{tpl(t.thN, { n })}</th>)}</tr></thead>
    <tbody>{MEAT_ROWS.map((x) => { const g = MEAT[x].rawG; return <tr><td>{d.k.meat[x].label}</td><td class="n">{f.g(g)} · {f.lb(g)}</td><td class="n">{f.g(10 * g)} · {f.lb(10 * g)}</td><td class="n">{f.g(25 * g)}</td><td class="n">{f.g(50 * g)}</td></tr>; })}</tbody>
  </table></div>
  <p class="table-note">{t.note}</p>
</Guide>
