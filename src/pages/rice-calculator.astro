---
import Base from '../layouts/Base.astro';
import RiceCalculator from '../components/RiceCalculator';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { rice, RICE_DEFAULT } from '../lib/kitchen';
import { RICE_COUNTS, RICE_TYPE_PAGES } from '../lib/presets';
import { faqLd, appLd } from '../lib/seo';
import { i18n, islandT, tpl } from '../i18n';
const { lang, d, f, h } = i18n(Astro.url.pathname);
const p = d.rice;
const rows = RICE_COUNTS.map((n) => ({ n, side: rice({ ...RICE_DEFAULT, adults: n, meal: 'side' }), main: rice({ ...RICE_DEFAULT, adults: n, meal: 'main' }) }));
const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
---
<Base title={p.title} description={p.description} jsonld={[appLd(p.appName, h('/rice-calculator/'), p.appDesc), faqLd(p.faq)]}>
  <section class="hero">
    <h1>{p.h1}</h1>
    <p>{p.lede}</p>
    <p class="answer" set:html={p.answer} />
  </section>
  <RiceCalculator client:load t={islandT(lang)} />
  <AdSlot />
  <section class="section prose">
    <h2>{p.whyH}</h2>
    <p>{p.why}</p>
  </section>
  <section class="section">
    <h2>{p.chartH}</h2>
    <p class="lede">{p.chartLede}</p>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>{p.thPeople}</th><th class="n">{p.thSideCups}</th><th class="n">{p.thSideWeight}</th><th class="n">{p.thMainCups}</th><th class="n">{p.thMainWeight}</th></tr></thead>
      <tbody>{rows.map(({ n, side, main }) => (
        <tr><td><a href={h(`/rice/for-${n}-people/`)}>{tpl(d.site.footPeople, { n })}</a></td><td class="n">{f.cups(side.dryCups)}</td><td class="n">{f.g(side.dryG)} · {f.lb(side.dryG)}</td><td class="n">{f.cups(main.dryCups)}</td><td class="n">{f.g(main.dryG)} · {f.lb(main.dryG)}</td></tr>
      ))}</tbody>
    </table></div>
  </section>
  <section class="section">
    <h2>{p.byType}</h2>
    <ul class="links">{RICE_TYPE_PAGES.map((r) => <li><a href={h(`/rice/${r.slug}/`)}>{tpl(p.typePerPerson, { name: cap(d.riceType.names[r.type]) })}</a></li>)}
      <li><a href={h('/rice-to-water-ratio/')}>{p.linkWater}</a></li><li><a href={h('/rice/kg-of-rice-for-people/')}>{p.linkKg}</a></li><li><a href={h('/rice/how-many-people-does-rice-feed/')}>{p.linkFeeds}</a></li><li><a href={h('/uncooked-to-cooked-rice/')}>{p.linkConvert}</a></li></ul>
  </section>
  <Faq items={p.faq} />
</Base>
