---
import Base from '../layouts/Base.astro';
import MeatCalculator from '../components/MeatCalculator';
import Faq from '../components/Faq.astro';
import AdSlot from '../components/AdSlot.astro';
import { MEAT, meat, MEAT_DEFAULT, type MeatType } from '../lib/kitchen';
import { MEAT_PAGES } from '../lib/meat-pages';
import { faqLd, appLd } from '../lib/seo';
import { i18n, islandT } from '../i18n';
const { lang, d, f, h } = i18n(Astro.url.pathname);
const p = d.meat;
const types = Object.keys(MEAT) as MeatType[];
---
<Base title={p.title} description={p.description} jsonld={[appLd(p.appName, h('/meat-per-person-calculator/'), p.appDesc), faqLd(p.faq)]}>
  <section class="hero">
    <h1>{p.h1}</h1>
    <p>{p.lede}</p>
    <p class="answer" set:html={p.answer} />
  </section>
  <MeatCalculator client:load t={islandT(lang)} />
  <AdSlot />
  <p class="qa-more section"><a href={h('/meat/per-person-in-kg/')}>{p.more}</a> · <a href={h('/questions/')}>{p.moreQuestions}</a></p>
  <section class="section">
    <h2>{p.chartH}</h2>
    <p class="lede">{p.chartLede}</p>
    <div class="table-wrap"><table class="table">
      <thead><tr><th>{p.thMeat}</th><th class="n">{p.thPer}</th><th class="n">{p.thTen}</th></tr></thead>
      <tbody>{types.map((t) => { const r = meat({ ...MEAT_DEFAULT, type: t }); return (
        <tr><td>{d.k.meat[t].label}</td><td class="n">{f.g(MEAT[t].rawG)} · {f.lb(MEAT[t].rawG)}</td><td class="n">{f.g(r.rawG)} · {f.lb(r.rawG)}</td></tr>); })}</tbody>
    </table></div>
  </section>
  <section class="section">
    <h2>{p.occasions}</h2>
    <ul class="links">{MEAT_PAGES.map((m) => <li><a href={h(`/meat/${m.slug}/`)}>{d.meatOcc.pages[m.slug].h1}</a></li>)}</ul>
  </section>
  <Faq items={p.faq} />
</Base>
