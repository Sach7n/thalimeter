---
import Base from '../layouts/Base.astro';
import { RICE, RICE_MEAL, PASTA, PASTA_MEAL, MEAT, MEAT_SHARE, APPETITE, RICE_METHOD_LABEL, type RiceType, type RiceMethod, type RiceMeal, type PastaType, type PastaMeal, type MeatType, type MeatShare } from '../lib/kitchen';
import { i18n, tpl } from '../i18n';
const { d, f, h } = i18n(Astro.url.pathname);
const p = d.how, k = d.k;
const methods = Object.keys(RICE_METHOD_LABEL) as RiceMethod[];
---
<Base title={p.title} description={p.description}>
  <section class="hero"><h1>{p.h1}</h1><p set:html={tpl(p.lede, { contact: h('/contact/') })} /></section>
  <div class="prose">
    <h2>{p.peopleH}</h2>
    <ul>{p.people.map((x) => <li set:html={tpl(x, { light: f.n(APPETITE.light), normal: f.n(APPETITE.normal), hearty: f.n(APPETITE.hearty) })} />)}</ul>
    <h2>{p.riceH}</h2>
    <ul>{(Object.keys(RICE_MEAL) as RiceMeal[]).map((x) => <li>{k.riceMeal[x].label}: <b>{RICE_MEAL[x].g} g</b> — {k.riceMeal[x].hint}</li>)}</ul>
    <h2>{p.typesH}</h2>
  </div>
  <div class="table-wrap" style="margin-top:12px"><table class="table">
    <thead><tr><th>{p.thRice}</th><th class="n">{p.thGCup}</th><th class="n">{p.thVol}</th><th class="n">{p.thWt}</th>{methods.map((m) => <th class="n">{tpl(p.thWater, { method: k.method[m] })}</th>)}</tr></thead>
    <tbody>{(Object.keys(RICE) as RiceType[]).map((x) => <tr><td>{k.rice[x].label}</td><td class="n">{RICE[x].gPerCup}</td><td class="n">{f.n(RICE[x].yieldVol)}</td><td class="n">{f.n(RICE[x].yieldWt)}</td>{methods.map((m) => <td class="n">{f.n(RICE[x].water[m])} : 1</td>)}</tr>)}</tbody>
  </table></div>
  <div class="prose">
    <p>{p.pot}</p>
    <h2>{p.pastaH}</h2>
    <ul>{(Object.keys(PASTA_MEAL) as PastaMeal[]).map((x) => <li set:html={tpl(p.pastaMeal, { label: k.pastaMeal[x].label, g: PASTA_MEAL[x].g })} />)}
      {(Object.keys(PASTA) as PastaType[]).map((x) => <li>{tpl(p.pastaType, { label: k.pasta[x].label, factor: f.n(PASTA[x].factor), yield: f.n(PASTA[x].yieldWt) })}</li>)}
      <li>{p.pastaRules}</li></ul>
    <h2>{p.meatH}</h2>
    <ul>{(Object.keys(MEAT) as MeatType[]).map((x) => <li>{k.meat[x].label}: <b>{MEAT[x].rawG} g</b> — {k.meat[x].cookedNote}</li>)}
      <li>{(Object.keys(MEAT_SHARE) as MeatShare[]).map((x) => `${k.share[x]}: × ${f.n(MEAT_SHARE[x].f)}`).join(' · ')}</li></ul>
    <h2>{p.unitsH}</h2>
    <ul>{p.units.map((x) => <li>{x}</li>)}</ul>
    <h2>{p.sourcesH}</h2>
    <p>{p.sources}</p>
  </div>
</Base>
