---
import { TOOLS } from '../config';
import { i18n } from '../i18n';
const { d, h } = i18n(Astro.url.pathname);
const c = { rice: 'var(--rice)', water: 'var(--water)', pasta: 'var(--pasta)', meat: 'var(--meat)' };
---
<ul class="toolrows">
  {TOOLS.map((t) => (
    <li><a href={h(t.href)}>
      <span class="tag" style={`--c:${c[t.tool]};${t.tool === 'pasta' ? '--on-c:var(--ink)' : ''}`}>{d.tools[t.key].tag}</span>
      <h3>{d.tools[t.key].name}</h3><p>{d.tools[t.key].blurb}</p><svg class="go" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
    </a></li>
  ))}
</ul>
