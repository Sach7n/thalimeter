---
// Answer page for one cluster of real search questions: short answer, chart, every question answered in the open.
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import { guide, guideVars, GUIDES } from '../lib/questions';
import { faqLd, crumbLd } from '../lib/seo';
import { i18n, tpl } from '../i18n';
interface Props { slug: string }
const { d, f, h } = i18n(Astro.url.pathname);
const g = guide(Astro.props.slug);
const t = d.guide[g.key], v = guideVars(g.key, f);
const faq = t.faq.map((x) => ({ q: tpl(x.q, v), a: tpl(x.a, v) }));
const strip = (s: string) => s.replace(/[?？؟;]$/, '');
---
<Base title={t.title} description={tpl(t.description, v)} jsonld={[faqLd(faq), crumbLd([[d.site.home, h('/')], [d.guide.crumb, h('/questions/')], [t.h1, h(g.slug)]])]}>
  <nav class="crumbs" aria-label={d.site.crumbAria}><a href={h('/')}>{d.site.home}</a> › <a href={h('/questions/')}>{d.guide.crumb}</a> › {strip(t.h1)}</nav>
  <section class="hero">
    <h1>{t.h1}</h1>
    <p class="answer">{tpl(t.lede, v)}</p>
  </section>
  <section><slot /></section>
  <section class="section qa">
    <h2>{d.guide.quick}</h2>
    {faq.map((x) => <div class="qa-item"><h3>{x.q}</h3><p set:html={x.a} /></div>)}
  </section>
  <AdSlot />
  <section class="section">
    <h2>{d.guide.work}</h2>
    <p class="lede">{d.guide.workLede}</p>
    <a class="btn" href={h(g.tool.href)}>{tpl(d.guide.open, { name: d.guide.tools[g.tool.name] })}</a>
  </section>
  <section class="section">
    <h2>{d.guide.more}</h2>
    <ul class="links">{GUIDES.filter((x) => x.slug !== g.slug).map((x) => <li><a href={h(x.slug)}>{strip(d.guide[x.key].h1)}</a></li>)}<li><a href={h('/questions/')}>{d.guide.all}</a></li></ul>
  </section>
</Base>
