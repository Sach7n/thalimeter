---
import { i18n } from '../i18n';
interface Props { items: { q: string; a: string }[]; title?: string }
const { d } = i18n(Astro.url.pathname);
const { items, title = d.site.faqTitle } = Astro.props;
---
<section class="section faq prose">
  <h2>{title}</h2>
  {items.map((f) => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}
</section>
